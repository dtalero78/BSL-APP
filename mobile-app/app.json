{
  "expo": {
    "name": "BSL Paciente",
    "slug": "bsl-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "owner": "dtalero",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#667eea"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bsl.paciente",
      "buildNumber": "19",
      "infoPlist": {
        "NSCameraUsageDescription": "La app necesita acceso a la cámara para las videollamadas con el médico.",
        "NSMicrophoneUsageDescription": "La app necesita acceso al micrófono para las videollamadas con el médico.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#667eea"
      },
      "package": "com.bsl.paciente",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "La app necesita acceso a la cámara para las videollamadas."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "La app necesita acceso al micrófono para las videollamadas."
        }
      ],
      [
        "react-native-twilio-video-webrtc",
        {
          "cameraPermission": "La app necesita acceso a la cámara para las videollamadas con el médico.",
          "microphonePermission": "La app necesita acceso al micrófono para las videollamadas con el médico."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 21
          },
          "ios": {
            "deploymentTarget": "15.1",
            "enableBitcode": false
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "46d8adda-9eb7-46f3-9da4-15229cc566e2"
      }
    }
  }
}
